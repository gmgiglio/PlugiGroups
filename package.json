{
  "name": "plugigroups",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy:test": "npm run build && node scripts/deploy-test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit_tests/*.test.ts",
    "test:core-plugins": "node tests/integration/corePlugins.mjs",
    "test:integration": "node tests/integration/liveRefresh.mjs",
    "test:collapse-persistence": "node tests/integration/collapsePersistence.mjs",
    "test:collapse-layout": "node tests/integration/collapseLayout.mjs",
    "test:search": "node tests/integration/globalSearch.mjs",
    "test:group-sync": "node tests/integration/groupViewSync.mjs",
    "test:plugin-reorder": "node tests/integration/pluginReorder.mjs",
    "test:dedicated-window": "node tests/integration/dedicatedWindow.mjs",
    "test:cli": "node tests/integration/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
